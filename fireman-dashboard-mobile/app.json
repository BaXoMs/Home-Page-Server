{
  "expo": {
    "name": "Fireman Dashboard",
    "slug": "fireman-dashboard-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#060911"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permite acceder al Fireman Dashboard mediante Face ID o Touch ID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060911"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
